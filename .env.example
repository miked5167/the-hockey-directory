# Hockey Directory - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Development: SQLite database (file-based)
DATABASE_URL="file:./dev.db"

# Production: PostgreSQL database
# DATABASE_URL="postgresql://username:password@localhost:5432/hockey_directory"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application URL (used for redirects, webhooks, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment (development, staging, production)
NODE_ENV="development"

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Secret Keys (generate strong random keys)
JWT_SECRET="your-jwt-secret-key-generate-a-strong-one"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-generate-a-strong-one"

# Encryption key for sensitive data (32 characters)
ENCRYPTION_KEY="your-32-character-encryption-key"

# Session secret for additional security
SESSION_SECRET="your-session-secret-key"

# =============================================================================
# STRIPE PAYMENT PROCESSING
# =============================================================================

# Stripe API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe webhook endpoint secret
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Connect platform account (for commissions)
STRIPE_CONNECT_CLIENT_ID="ca_..."

# =============================================================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# =============================================================================

# Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAAA..."

# Turnstile secret key (private)
TURNSTILE_SECRET_KEY="0x4AAAAAAAA..."

# =============================================================================
# EMAIL SERVICE (SendGrid, Mailgun, or similar)
# =============================================================================

# Email service configuration
EMAIL_SERVICE_API_KEY="your-email-service-api-key"
EMAIL_FROM="noreply@hockeydirectory.com"
EMAIL_FROM_NAME="Hockey Directory"

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID="G-..."

# Sentry Error Tracking
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="your-org"
SENTRY_PROJECT="hockey-directory"

# =============================================================================
# FILE STORAGE & CDN
# =============================================================================

# Upload storage configuration
UPLOAD_MAX_SIZE="5242880"  # 5MB in bytes
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# CDN/Storage service (Cloudinary, AWS S3, etc.)
CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-key" 
CLOUDINARY_API_SECRET="your-cloudinary-secret"

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Database tools
PRISMA_STUDIO_PORT="5555"

# Logging level
LOG_LEVEL="debug"

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# Rate limiting configuration
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_STORE="memory"  # memory, redis

# Security headers
SECURITY_HEADERS_ENABLED="true"

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# SMS Service (Twilio - optional)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Social media API keys (for verification)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-secret"

# =============================================================================
# TESTING & STAGING
# =============================================================================

# Test database (for running tests)
TEST_DATABASE_URL="file:./test.db"

# Feature flags override
FEATURE_FLAGS_OVERRIDE=""

# Debug mode
DEBUG="false"

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Vercel deployment configuration
VERCEL_URL=""
VERCEL_ENV=""

# Docker configuration (if used)
PORT="3000"
HOST="0.0.0.0"