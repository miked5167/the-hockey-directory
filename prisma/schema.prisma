// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Directory Entities

model Advisor {
  id              String   @id @default(cuid())
  slug            String   @unique // SEO-friendly URL slug
  name            String
  headshot        String?  // Profile photo URL
  city            String
  province        String
  country         String
  bio             String?
  website         String?
  socials         String?  // JSON string: {linkedin, twitter, instagram}
  specialties     String?  // JSON string of specialties array
  levels          String?  // JSON string: ['youth', 'junior', 'college', 'pro']
  verified        Boolean  @default(false)
  featuredUntil   DateTime? // When featured status expires
  completeness    Int      @default(0) // Profile completeness score 0-100
  responseTimeMs  Int?     // Average response time in milliseconds
  email           String   @unique
  phone           String?
  yearsExperience Int?
  certifications  String?  // JSON string of certifications array
  location        String   // Full location for backward compatibility
  linkedIn        String?  // Deprecated - use socials
  imageUrl        String?  // Deprecated - use headshot
  rating          Float?   @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Business relationships
  subscription AdvisorSubscription?
  entitlements Entitlement[]
  leads        Lead[]
  payments     Payment[]
  reviews      Review[]
  events       Event[]

  @@map("advisors")
}

model Coach {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String?
  bio             String?
  coachingLevel   String   // Youth, Junior, Professional, etc.
  yearsExperience Int?
  certifications  String? // JSON string array
  location        String
  teamAffiliation String?
  imageUrl        String?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("coaches")
}

model Tournament {
  id            String    @id @default(cuid())
  name          String
  description   String?
  location      String
  startDate     DateTime
  endDate       DateTime
  ageGroups     String? // JSON string of age groups array
  divisions     String? // JSON string of divisions array
  entryFee      Float?
  maxTeams      Int?
  contactEmail  String
  contactPhone  String?
  website       String?
  registrationDeadline DateTime?
  status        String   @default("upcoming") // upcoming, ongoing, completed, cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tournaments")
}

model PrepSchool {
  id           String   @id @default(cuid())
  name         String
  location     String
  address      String?
  website      String?
  phone        String?
  email        String?
  description  String?
  tuitionRange String? // "10000-20000"
  grades       String? // JSON string array
  hockeyProgram String? // Description of hockey program
  facilities   String? // JSON string array
  accreditation String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("prep_schools")
}

model Arena {
  id          String   @id @default(cuid())
  name        String
  location    String
  address     String
  phone       String?
  website     String?
  email       String?
  description String?
  facilities  String? // JSON string: ice rinks, locker rooms, etc.
  iceSheets   Int?
  publicSkate Boolean  @default(false)
  hockeyPrograms Boolean @default(false)
  rentalAvailable Boolean @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("arenas")
}

// Business Entities

model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String  @unique // "basic", "featured", "premium"
  displayName String  // "Basic Listing", "Featured Listing", "Premium Listing"
  description String?
  monthlyPrice Float
  yearlyPrice  Float?
  features    String? // JSON string of features array
  maxLeads    Int?     // Maximum leads per month
  featured    Boolean  @default(false)
  priority    Int      @default(0) // Higher number = higher priority in listings
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  subscriptions AdvisorSubscription[]

  @@map("subscription_plans")
}

model AdvisorSubscription {
  id          String    @id @default(cuid())
  advisorId   String    @unique
  planId      String
  status      String    @default("active") // active, cancelled, expired, suspended
  startDate   DateTime  @default(now())
  endDate     DateTime?
  autoRenew   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  advisor Advisor          @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("advisor_subscriptions")
}

model Lead {
  id          String   @id @default(cuid())
  advisorId   String
  parentEmail String
  parentPhone String?
  parentName  String
  playerAge   Int?
  message     String
  status      String   @default("new") // new, contacted, qualified, won, lost
  source      String   @default("website") // website, referral, etc.
  leadValue   Float?   // Estimated value of the lead for commission calculation
  conversionDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  advisor Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model Payment {
  id           String    @id @default(cuid())
  advisorId    String
  type         String    // "subscription", "commission", "featured_listing"
  amount       Float
  currency     String    @default("USD")
  status       String    @default("pending") // pending, completed, failed, refunded
  stripePaymentId String?
  description  String?
  leadId       String?   // If this is a commission payment
  dueDate      DateTime?
  paidDate     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  advisor Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id         String   @id @default(cuid())
  advisorId  String
  rating     Int      // 1-5 stars
  title      String
  body       String
  authorName String
  status     String   @default("pending") // pending, approved, rejected
  adminNotes String?  // Moderation notes
  helpful    Int      @default(0) // Helpful votes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  advisor Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// New models from development standards

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  role      String    // admin, advisor, parent
  advisorId String?   // Links to advisor profile if role is advisor
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  events           Event[]
  moderationQueue  ModerationQueue[]

  @@map("users")
}

model Plan {
  id            String  @id @default(cuid())
  name          String  @unique // basic, featured, premium
  priceMonth    Int     // Price in cents
  priceYear     Int     // Price in cents
  featuresJson  String  // JSON string of features
  maxLeads      Int?    // Monthly lead limit, null = unlimited
  priority      Int     @default(0) // Search priority score
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  entitlements Entitlement[]

  @@map("plans")
}

model Entitlement {
  id                 String    @id @default(cuid())
  advisorId          String
  planId             String
  active             Boolean   @default(true)
  renewsAt           DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  stripeSubscriptionId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relationships
  advisor Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@map("entitlements")
}

model Event {
  id          String   @id @default(cuid())
  name        String   // Event type: profile_viewed, lead_submitted, etc.
  payloadJson String   // JSON data for the event
  userId      String?  // User who triggered the event
  advisorId   String?  // Advisor related to the event
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relationships
  user    User?    @relation(fields: [userId], references: [id])
  advisor Advisor? @relation(fields: [advisorId], references: [id])

  @@map("events")
}

model ModerationQueue {
  id          String    @id @default(cuid())
  type        String    // review, profile, lead
  refId       String    // ID of the item being moderated
  status      String    @default("pending") // pending, approved, rejected
  notes       String?
  moderatorId String?   // User ID of the moderator
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  moderator User? @relation(fields: [moderatorId], references: [id])

  @@map("moderation_queue")
}
